<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.redhat.Varlink</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Varlink</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://redhat.com">Red Hat</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Provides basic support for Varlink file format.<br>
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>


    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Varlink File"
                implementationClass="org.intellij.sdk.language.VarlinkFileType"
                fieldName="INSTANCE"
                language="Varlink"
                extensions="varlink"/>
        <lang.parserDefinition
                language="Varlink"
                implementationClass="org.intellij.sdk.language.VarlinkParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="Varlink"
                implementationClass="org.intellij.sdk.language.VarlinkSyntaxHighlighterFactory"/>
        <annotator
                language="Varlink"
                implementationClass="org.intellij.sdk.language.VarlinkAnnotator"/>
        <lang.braceMatcher
                language="Varlink"
                implementationClass="org.intellij.sdk.language.VarlinkBraceMatcher"/>
        <completion.contributor
                language="Varlink"
                implementationClass="org.intellij.sdk.language.VarlinkCompletionContributor"/>
        <psi.referenceContributor
                language="Varlink"
                implementation="org.intellij.sdk.language.VarlinkReferenceContributor"/>
        <lang.findUsagesProvider
                language="Varlink"
                implementationClass="org.intellij.sdk.language.VarlinkFindUsagesProvider"/>
        <lang.foldingBuilder
                language="Varlink"
                implementationClass="org.intellij.sdk.language.VarlinkFoldingBuilder"/>
    </extensions>

</idea-plugin>
